  try{
    var r=await fetch("/api/backup/last"+QS);
    var d=await r.json();
    var html = "";
    if(d.ok && d.hasBackup){
      var b = d.backup;
      html += '<div style="margin-bottom:16px;padding:16px;background:var(--bg);border-radius:8px;border:1px solid var(--border)">';
      html += '<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">';
      html += '<div><span style="font-size:14px;font-weight:600">📦 最近备份</span>';
      html += '<div style="font-size:12px;color:var(--text-dim);margin-top:4px">' + b.time + ' · ' + b.dir + '</div></div>';
      html += '<div style="display:flex;gap:16px;flex-wrap:wrap"><div style="text-align:center;padding:8px 16px;background:rgba(34,197,94,0.1);border-radius:8px"><div style="font-size:20px;font-weight:700;color:var(--green)">' + b.ok + '</div><div style="font-size:11px;color:var(--text-dim)">成功</div></div>';
      html += '<div style="text-align:center;padding:8px 16px;background:' + (b.fail>0?'rgba(239,68,68,0.1)':'rgba(255,255,255,0.04)') + ';border-radius:8px"><div style="font-size:20px;font-weight:700;color:' + (b.fail>0?'var(--red)':'var(--text-dim)') + '">' + b.fail + '</div><div style="font-size:11px;color:var(--text-dim)">失败</div></div>';
      html += '<div style="text-align:center;padding:8px 16px;background:rgba(255,255,255,0.04);border-radius:8px"><div style="font-size:20px;font-weight:700;color:var(--text)">' + b.totalPorts + '</div><div style="font-size:11px;color:var(--text-dim)">端口</div></div>';
      html += '<div style="text-align:center;padding:8px 16px;background:rgba(255,255,255,0.04);border-radius:8px"><div style="font-size:20px;font-weight:700;color:var(--text)">' + b.sizeMB + '</div><div style="font-size:11px;color:var(--text-dim)">MB</div></div></div>';
      html += '</div></div>';
    } else {
      html += '<div style="margin-bottom:16px;padding:16px;background:var(--bg);border-radius:8px;border:1px solid var(--border)"><div style="font-size:14px;color:var(--text-dim)">⚠️ 暂无备份记录</div></div>';
    }
    // 备份目录列表
    html += '<div style="margin-bottom:12px;display:flex;gap:8px;flex-wrap:wrap">';
    html += '<button class="btn btn-green" onclick="runBackup()">🔄 立即备份</button>';
    html += '<button class="btn" onclick="loadBackupList()">📂 查看备份列表</button>';
    html += '<button class="btn btn-ghost" onclick="closeBackupPanel()">关闭</button>';
    html += '</div>';
    html += '<div id="backupListArea"></div>';
    document.getElementById("backupContent").innerHTML = html;
  } catch(e){
    document.getElementById("backupContent").innerHTML = '<div style="color:var(--red)">❌ 加载失败: ' + esc(e.message) + '</div>';
  }
}

function closeBackupPanel(){
  document.getElementById("backupModal").classList.remove("active");
}

async function runBackup(){
  document.getElementById("backupContent").innerHTML = '<div style="text-align:center;padding:40px"><div style="font-size:18px;margin-bottom:8px">⏳ 正在备份...</div><div style="font-size:12px;color:var(--text-dim)">备份12端口源码，可能需要30~60秒</div></div>';
  try{
    var r=await fetch("/api/backup/run"+QS,{method:'POST'});
    var d=await r.json();
    if(d.ok){
      notify("✅ 备份成功: " + d.backup.ok + "/" + d.backup.total + " 端口, 清理 " + d.backup.fail + " 个失败");
      showBackupPanel(); // 刷新面板
    } else {
      document.getElementById("backupContent").innerHTML = '<div style="color:var(--red);padding:20px">❌ 备份失败: ' + esc(d.error) + '<br><pre style="margin-top:8px;font-size:11px;background:var(--bg);padding:12px;border-radius:6px;overflow:auto;max-height:200px">' + esc(d.stderr||'') + '</pre><button class="btn" style="margin-top:12px" onclick="showBackupPanel()">返回</button></div>';
    }
  } catch(e){
    document.getElementById("backupContent").innerHTML = '<div style="color:var(--red);padding:20px">❌ 备份执行失败: ' + esc(e.message) + '<br><button class="btn" style="margin-top:12px" onclick="showBackupPanel()">返回</button></div>';
  }
}

async function loadBackupList(){
  var area = document.getElementById("backupListArea");
  area.innerHTML = '<div class="pulse">⏳ 加载备份列表...</div>';
  try{
    // 从backupRoot目录读取
    var r=await fetch("/api/backup/last"+QS);
    var d=await r.json();
    // 如果有备份就展示目录信息
    if(d.ok) {
      area.innerHTML = '<div style="margin-top:12px;padding:12px;background:var(--bg);border-radius:8px;border:1px solid var(--border)">';
      area.innerHTML += '<div style="font-size:12px;font-weight:600;margin-bottom:8px">📂 备份位置</div>';
      area.innerHTML += '<code style="font-size:11px;color:var(--green)">E:\desktop\port-backups\</code>';
      area.innerHTML += '<div style="font-size:11px;color:var(--text-dim);margin-top:6px">定时备份: 每天 04:45 (保留最近3天)</div>';
      area.innerHTML += '<div style="font-size:11px;color:var(--text-dim)">每个端口独立目录, 附 README 说明。通过仪表盘或 9050 文件管理器可浏览和恢复。</div>';
      area.innerHTML += '</div>';
    } else {
      area.innerHTML = '<div style="margin-top:12px;padding:12px;background:var(--bg);border-radius:8px;border:1px solid var(--border);color:var(--text-dim);font-size:12px">暂无备份记录</div>';
    }
  } catch(e){
    area.innerHTML = '<div style="color:var(--red);font-size:12px;margin-top:12px">❌ ' + esc(e.message) + '</div>';
  }
}


// ─── 初始化 ──────────────────────────────────────────────────
if(!PASS&&location.search){var sp=new URLSearchParams(location.search);PASS=sp.get("password")||"";QS=PASS?"?password="+encodeURIComponent(PASS):"";}
refreshNow();
</script>
