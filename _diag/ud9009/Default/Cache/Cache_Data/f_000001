  var full=CF_GW+'/?password='+CF_PW;
  var disp=CF_GW+'/?password=xxxxxxxx';
  var age='';
  if(CF_UPDATED){
    var m=Math.round((Date.now()-CF_UPDATED)/60000);
    age='地址更新于 '+(m<1?'刚刚':m+' 分钟前');
  }
  var h=tsh+'<div class="card" style="margin-bottom:14px;border:1px solid #3b82f6"><div class="card-body"><div class="svc-info" style="width:100%">';
  h+='<div class="svc-name"><span class="port-tag" style="background:#3b82f622;color:#3b82f6">CF</span> 🌐 外网统一入口（9060 认证网关）</div>';
  h+='<div class="svc-desc">一个地址走全部服务（路径前缀分发）· 密码位置见 xxxxxxxx，自行替换'
    +(age?' · '+esc(age):'')+' · cloudflared 在线 '+CF_PROCS+'</div>';
  h+='<div style="margin-top:6px;font-size:12px;line-height:2">';
  h+='<a href="'+esc(full)+'" target="_blank" title="'+esc(disp)+'" style="color:var(--green);text-decoration:underline;text-underline-offset:2px">⧉ 打开仪表盘（外网）</a> ';
  h+='<button class="btn btn-sm" style="padding:1px 8px;font-size:10px" onclick="copyCf(\''+esc(disp)+'\')">📋 复制地址</button>';
