// ─── 健康检测 ────────────────────────────────────────────────
async function checkAllResponses(){
  if(checkingHealth)return;
  checkingHealth=true;healthResults={};
  var btn=document.getElementById("btnCheckResp");
  btn.disabled=true;btn.textContent='⏳ 检测...';
  try{
    var sr=await fetch("/api/status"+QS),sd=await sr.json();
    var lr=await fetch("/api/list"+QS),ld=await lr.json();
    var svcs=ld.services||[],runningPorts=[];
    for(var i=0;i<svcs.length;i++){var st=sd.statuses[svcs[i].port];if(st&&st.status==="running"){healthResults[svcs[i].port]='pending';runningPorts.push(svcs[i].port);}}
    if(!runningPorts.length){notify('没有运行中的服务','warn');btn.disabled=false;btn.textContent='🔍 检测';checkingHealth=false;return;}
    renderServices({services:svcs,statuses:sd.statuses});
    await Promise.all(runningPorts.map(checkOneService));
    refreshNow();
    var ok=runningPorts.filter(function(p){return healthResults[p]&&healthResults[p].ok}).length;
    notify(ok+'/'+runningPorts.length+' 服务响应正常');
  }catch(e){console.error(e)}
  btn.disabled=false;btn.textContent='🔍 检测';checkingHealth=false;
  if(healthCheckTimer)clearTimeout(healthCheckTimer);
  healthCheckTimer=setTimeout(function(){healthResults={};},6000);
}
function checkOneService(port){return new Promise(function(resolve){
  var xhr=new XMLHttpRequest();
  xhr.open('GET','/api/check-response/'+port+QS,true);xhr.timeout=8000;
  xhr.onload=function(){try{var j=JSON.parse(xhr.responseText);healthResults[port]=(j&&j.ok!==undefined)?j:{ok:false,error:'bad_resp'};}catch(e){healthResults[port]={ok:false,error:'parse_err'};}resolve();};
  xhr.onerror=function(){healthResults[port]={ok:false,error:'net_err'};resolve();};
  xhr.ontimeout=function(){healthResults[port]={ok:false,error:'TIMEOUT'};resolve();};
  xhr.send();
});}


