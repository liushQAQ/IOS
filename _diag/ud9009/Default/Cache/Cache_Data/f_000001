// ─── 渲染卡片 ────────────────────────────────────────────────
function renderServices(data){
  var EXT_BASE=(CF_GW||'').replace(/\/+$/,'');
  function extReal(){return EXT_BASE?EXT_BASE+'/?password='+encodeURIComponent(CF_PW):'';}
  function extDisp(){return EXT_BASE?EXT_BASE+'/?password='+CF_PW:'隧道未就绪';}
  function extEntry(suffix) {
    if(!EXT_BASE) return null;
    // suffix格式: '/game/?name=玩家&message=签到'
    var qIdx = suffix.indexOf('?');
    var path = qIdx >= 0 ? suffix.substring(0, qIdx) : suffix;
    var query = qIdx >= 0 ? suffix.substring(qIdx + 1) : '';

    // 显示层一律遮蔽为 xxxxxxxx（老总手动替换）；href 仍带真实密码，点击即可用
    var href = EXT_BASE + path + '?password=' + encodeURIComponent(CF_PW);
    if (query) href += '&' + query;
    var text = EXT_BASE + path + '?password=xxxxxxxx';
    if (query) text += '&' + query;

    return {href: href, text: text};
  }
  var LAN_HOST=detectLanHost();
  var portUrls={
    9009:{local:'http://'+LAN_HOST+':9009/',external:extEntry('/')},
    8200:{local:'http://'+LAN_HOST+':8200/?name=歌名',external:extEntry('/music/?name=歌名')},
    8070:{local:'http://'+LAN_HOST+':8070/?name=玩家&message=签到',external:extEntry('/game/?name=玩家&message=签到')},
    8060:{local:'http://'+LAN_HOST+':8060/v1/models',external:extEntry('/wb/v1/models')},
    8300:{local:'http://'+LAN_HOST+':8300/api?keyword=渣男语录',external:extEntry('/quote/api?keyword=渣男语录')},
    8020:{local:'http://'+LAN_HOST+':8020/?q=关键词',external:extEntry('/search?q=关键词')},
    8040:{local:'http://'+LAN_HOST+':8040/v1/models',external:extEntry('/agent/v1/models')},
    8050:{local:'http://'+LAN_HOST+':8050/',external:''},
    8030:{local:'http://'+LAN_HOST+':8030/',external:extEntry('/recap/')},
    8011:{local:'http://'+LAN_HOST+':8011/duanshipin?url=...',external:extEntry('/video/duanshipin?url=视频网址')},
    8120:{local:'http://'+LAN_HOST+':8120/=关键词',external:extEntry('/video-unified/=关键词')},
    9050:{local:'http://'+LAN_HOST+':9050/',external:''},
    8080:{local:'http://'+LAN_HOST+':8080/',external:''},
    9060:{local:'http://'+LAN_HOST+':9060/',external:''},
    3081:{local:'http://'+LAN_HOST+':3081/',external:extEntry('/dsh/')},
    57890:{local:'http://127.0.0.1:57890/',external:''},
    6066:{local:'http://'+LAN_HOST+':6066/',external:extEntry('/latest_shouban.png')},
    8899:{local:'http://'+LAN_HOST+':8899/',external:extEntry('/meter/')},
    8210:{local:'http://'+LAN_HOST+':8210/',external:extEntry('/tts/')}
  };
  var svcs=data.services||[];
  // 排序：9009永远第一，其余按端口从小到大
  svcs.sort(function(a,b){
    if(a.port===9009)return -1;
    if(b.port===9009)return 1;
    return a.port-b.port;
  });
  var sts=data.statuses||{},n=0,healthy=0;
  for(var k in sts){
    if(sts[k].status==="running")n++;
    if(sts[k].status==="running"&&sts[k].healthy!==false)healthy++;
  }
  var quota=data.volcQuota||{};
  document.getElementById("countBadge").textContent=" "+healthy+" 健康 / "+n+" 在线 / "+svcs.length+" 服务";
  var age=data.updatedAt?Date.now()-data.updatedAt:0;
  document.getElementById("updateTime").textContent=age<3000?"刚刚更新":"更新于 "+new Date(data.updatedAt).toLocaleTimeString("zh-CN",{hour12:false})+" ("+Math.round(age/1000)+"s 前)";
  var h="";
  for(var i=0;i<svcs.length;i++){
    var s=svcs[i],st=sts[s.port]||{status:"stopped"},r=st.status==="running",unhealthy=st.healthy===false,c=s.color||"#888";
    var cls=unhealthy?"unhealthy":(r?"running":"stopped");
    var disabledAttr=BUSY?' disabled':'';
    h+='<div class="card '+cls+'"><div class="card-body">';
    h+='<span class="status-dot '+(unhealthy?"stopped":(r?"running":"stopped"))+'"></span>';
    h+='<div class="svc-info"><div class="svc-name">';
    h+='<span class="port-tag" style="background:'+c+'22;color:'+c+'">'+s.port+'</span> '+esc(s.name);
var hc=healthResults[s.port];
    if(hc==='pending')h+=' <span class="health-badge pending">检测中...</span>';
