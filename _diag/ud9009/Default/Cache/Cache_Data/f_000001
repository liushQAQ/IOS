// ─── 批量操作 ────────────────────────────────────────────────
async function startAll(){
  if(BUSY)return;setOperationsEnabled(false);notify('正在启动所有服务...');
  try{
    var sr=await fetch("/api/status"+QS),sd=await sr.json();
    var lr=await fetch("/api/list"+QS),ld=await lr.json();
    var svcs=ld.services||[],errs=[];
    for(var i=0;i<svcs.length;i++){
      var st=sd.statuses[svcs[i].port];
      if(!st||st.status!=="running"){
        try{var r2=await fetch("/api/start/"+svcs[i].port+QS);var j2=await r2.json();if(!j2.ok)errs.push(svcs[i].port);}catch(e){errs.push(svcs[i].port);}
        await new Promise(function(r){setTimeout(r,500);});
      }
    }
    if(errs.length)notify('完成，'+errs.length+' 个失败','warn');else notify('全部已启动');
  }catch(e){notify('启动失败: '+e.message,'error')}
  setOperationsEnabled(true);refreshNow();
}
async function stopAll(){
  if(BUSY)return;setOperationsEnabled(false);notify('正在停止所有服务...');
  try{
    var sr=await fetch("/api/status"+QS),sd=await sr.json();
    var lr=await fetch("/api/list"+QS),ld=await lr.json();
    var svcs=ld.services||[];
    for(var i=0;i<svcs.length;i++){if(svcs[i].port===9009)continue;var st=sd.statuses[svcs[i].port];if(st&&st.status==="running"){await fetch("/api/stop/"+svcs[i].port+QS);}}
    notify('全部已停止');
  }catch(e){notify('停止失败: '+e.message,'error')}
  setOperationsEnabled(true);refreshNow();
}
async function restartAll(){
  if(BUSY)return;
  if(!confirm('确定重启全部服务？先停止所有运行中的服务，再依次启动'))return;
  setOperationsEnabled(false);notify('正在重启全部服务...');
  try{
    var sr=await fetch("/api/status"+QS),sd=await sr.json();
    var lr=await fetch("/api/list"+QS),ld=await lr.json();
    var svcs=ld.services||[];
    for(var i=0;i<svcs.length;i++){if(svcs[i].port===9009)continue;var st=sd.statuses[svcs[i].port];if(st&&st.status==="running"){await fetch("/api/stop/"+svcs[i].port+QS);}}
