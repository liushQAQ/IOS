<script>
var PASS=(typeof PASS!=='undefined')?PASS:'';var QS=PASS?'?password='+encodeURIComponent(PASS):'';
var autoRefreshTimer=null,BUSY=false,healthResults={},checkingHealth=false,healthCheckTimer=null;
// Cloudflare 统一入口（由 /api/cf-tunnels 动态注入，地址每次重建自动跟随）
var CF_GW='',CF_PW='Liu326766@',CF_UPDATED=0,CF_PROCS=0,CF_DIRECT={};
var TS_HOST='100.113.97.47';
// 局域网 IP 动态探测：跟随用户访问入口（避免 DHCP 变更后写死旧 IP 导致内网链接全失效）
function detectLanHost(){
  try{
    var h=location.hostname||'';
    // 公网域名（CF 隧道 / Tailscale / Workers）不能当内网主机用
    var isPublic=/trycloudflare\.com$/i.test(h)||/\.ts\.net$/i.test(h)||/\.workers\.dev$/i.test(h);
    if(h && h!=='localhost' && h!=='127.0.0.1' && h!=='::1' && !h.startsWith('0.') && !isPublic) return h;
  }catch(e){}
  return '192.168.215.218'; // 兜底：本机直访或经公网隧道访问时用当前实际局域网 IP
}
function esc(t){return t==null?'':String(t).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;")}
function notify(msg,type){
  var n=document.getElementById('notif');
  n.textContent=msg;
  n.style.borderColor=type==='error'?'var(--red)':type==='warn'?'var(--yellow)':'var(--green)';
  n.classList.add('show');setTimeout(function(){n.classList.remove('show');},3000);
}

// 端口配置
const portUrls = {
  '8050': 'http://127.0.0.1:8050',
  '8030': 'http://127.0.0.1:8030',
  '8120': 'http://127.0.0.1:8120',
  '8060': 'http://127.0.0.1:8060/v1/models',
  '8040': 'http://127.0.0.1:8040/v1/models',
  '8020': 'http://127.0.0.1:8020',
  '8200': 'http://127.0.0.1:8200',
  '9050': 'http://127.0.0.1:9050',
  '9009': 'http://127.0.0.1:9009',
  '9060': 'http://127.0.0.1:9060',
  '8080': 'http://127.0.0.1:8080',
  '3081': 'http://127.0.0.1:3081'
};

// ─── Dropdown ────────────────────────────────────────────────
function toggleDropdown(id){
  document.querySelectorAll('.dropdown-menu').forEach(function(m){if(m.closest('.dropdown-wrap').id!==id)m.classList.remove('active');});
  document.querySelector('#'+id+' .dropdown-menu').classList.toggle('active');
}
function closeDropdown(){document.querySelectorAll('.dropdown-menu').forEach(function(m){m.classList.remove('active');});}
document.addEventListener('click',function(e){if(!e.target.closest('.dropdown-wrap'))closeDropdown();});

// ─── 操作状态 ────────────────────────────────────────────────
function setOperationsEnabled(v){
  BUSY=!v;
  document.querySelectorAll('#toolbar button').forEach(function(b){b.disabled=!v;});
  document.querySelectorAll('#serviceList button').forEach(function(b){b.disabled=!v;});
  document.querySelectorAll('.card').forEach(function(c){c.classList.toggle('loading',!v);});
  document.body.style.cursor=v?'':'wait';
  document.getElementById('statusArea').style.display=v?'none':'flex';
}

// ─── 外网统一入口卡片（CF 固定地址 + 完整密码）─────────────
function copyCf(t){
  try{
    navigator.clipboard.writeText(t).then(function(){notify('外网地址（含密码）已复制');})
      .catch(function(){notify('复制失败，请手动选中','error');});
  }catch(e){ notify('复制失败，请手动选中','error'); }
}
